[Unit]
Description=PoseiTech Baileys WhatsApp
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=baileys
Group=baileys
WorkingDirectory=/opt/poseitech-baileys
ExecStart=/usr/bin/node /opt/poseitech-baileys/server.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/poseitech-baileys/data

[Install]
WantedBy=multi-user.target
