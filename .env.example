APP_NAME="PoseiTech CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
SEO_INDEXING=false
SEO_SITE_NAME="PoseiTech CRM"
SEO_DESCRIPTION="Gestão de vendas, clientes, atendimento e pedidos em um só lugar."

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=poseitech_crm
DB_USERNAME=root
DB_PASSWORD=

# PDO: limite de estabelecimento (segundos); nao limita consultas.
DB_CONNECT_TIMEOUT=3
# Pool externo por instancia PHP: veja deploy/MYSQL.md antes de ativar.
# DB_HOST=127.0.0.1 e DB_PORT=6033 apenas depois de instalar o proxy.
DB_POOL_SIZE=10
DB_POOL_CLIENTS=32
DB_POOL_WAIT_TIMEOUT_MS=3000
DB_QUERY_TIMEOUT_MS=10000
DB_POOL_INSTANCES=1
DB_CONNECTION_RESERVE=5
# 0 exige informar um orcamento confirmado pelo provedor antes de gerar o proxy.
DB_CONNECTION_BUDGET=0
DB_UPSTREAM_HOST=
DB_UPSTREAM_PORT=3306
DB_CAPACITY_COOLDOWN_SECONDS=300
DB_SATURATION_COOLDOWN_SECONDS=3
# Alerta por tempo SQL acumulado; 0 desativa. Nunca registra SQL/bindings.
DB_SLOW_REQUEST_MS=1000

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WHATSAPP_SERVICE_URL=http://127.0.0.1:3100
WHATSAPP_SERVICE_TOKEN=
WHATSAPP_SESSION_KEY=
WHATSAPP_SERVICE_HOST=127.0.0.1
WHATSAPP_SERVICE_PORT=3100

# true when the supervised poseitech:deliver service is running
DELIVERY_DAEMON=false
