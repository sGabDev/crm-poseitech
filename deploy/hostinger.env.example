APP_NAME="PoseiTech CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seu-dominio.com
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_poseitech
DB_USERNAME=u123456789_poseitech
DB_PASSWORD="SUBSTITUA_PELA_SENHA_DO_BANCO"

DB_CONNECT_TIMEOUT=3
# Pool externo somente se a hospedagem oferecer proxy ou permitir instala-lo.
# Veja MYSQL.md; nao altere DB_PORT sem instalar e validar o proxy.
DB_POOL_SIZE=10
DB_POOL_CLIENTS=32
DB_POOL_WAIT_TIMEOUT_MS=3000
DB_QUERY_TIMEOUT_MS=10000
DB_POOL_INSTANCES=1
DB_CONNECTION_RESERVE=5
DB_CONNECTION_BUDGET=0
DB_UPSTREAM_HOST=
DB_UPSTREAM_PORT=3306
DB_CAPACITY_COOLDOWN_SECONDS=300

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# SMTP global: recuperação de senha. SMTP de cada empresa fica em Configurações.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contato@seu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"
